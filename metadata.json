{
    "project_name": "NightWatch AI",
    "model": "XGBoost",
    "input_features": [
        "city",
        "daytime_avg_temp",
        "daytime_max_temp",
        "daytime_avg_humidity",
        "daytime_avg_wind",
        "daytime_avg_cloud",
        "month",
        "day_of_year",
        "previous_night_temp",
        "two_nights_ago_temp",
        "previous_3_night_avg"
    ],
    "global_warm_anomaly_threshold": 1.718,
    "city_thresholds": {
        "Abu Dhabi": 1.4,
        "Al Ain": 1.782,
        "Dubai": 1.403,
        "Ras Al Khaimah": 2.115,
        "Sharjah": 1.418
    },
    "prediction_unit": "Celsius",
    "cities": [
        "Abu Dhabi",
        "Al Ain",
        "Dubai",
        "Ras Al Khaimah",
        "Sharjah"
    ]
}